# Used by `npm run build` (production mode) - see src/api/apiBase.ts.
# Local dev (`npm run dev`) ignores this file and stays on the Vite proxy
# in vite.config.ts, which forwards to localhost:8080.
VITE_API_BASE_URL=https://xerxes-msme-backend-1059814630808.asia-south1.run.app

# frontend-web's deployed origin - see src/lib/dashboardUrl.ts. Without this, the
# "Already listed? Manage your shop" link (and related copy) falls back to
# localhost:5173, which is wrong in a deployed build.
VITE_DASHBOARD_URL=https://xerxes-msme-frontend-web-1059814630808.asia-south1.run.app